# Configuración de svc-reservaciones (lo que NO es secreto). Kustomize la
# convierte en el ConfigMap svc-reservaciones-config-<hash>: si cambia un
# valor, el Deployment crea pods nuevos que la leen (ver kustomization.yaml).
# La base, el usuario y la contraseña se toman de postgres-config y
# postgres-app (deployment.yaml), para no repetirlos.
OTEL_SERVICE_NAME=svc-reservaciones
DB_HOST=postgres
DB_PORT=5432
# Conexiones máximas
DB_POOL_MAX=5
LOG_LEVEL=INFO
# 0 a 1: fracción de peticiones que responden 500 a propósito (demo 3).
# Se cambia con un commit, como todo lo demás.
ERROR_RATE=0
# Cuánto tiempo quedan apartados los lugares sin pagar
RESERVA_MINUTOS=10
# Cada cuánto se liberan las reservaciones vencidas
LIBERADOR_SEGUNDOS=60
# OTEL_EXPORTER_OTLP_ENDPOINT se agrega en la etapa de logs y trazas (Jaeger)
