# Configuración de svc-ordenes (lo que NO es secreto). Kustomize la convierte
# en el ConfigMap svc-ordenes-config-<hash>: si cambia un valor, el
# Deployment crea pods nuevos que la leen (ver kustomization.yaml).
# La base, el usuario y la contraseña se toman de postgres-config y
# postgres-app (deployment.yaml), para no repetirlos.
OTEL_SERVICE_NAME=svc-ordenes
DB_HOST=postgres
DB_PORT=5432
# Conexiones máximas
DB_POOL_MAX=5
LOG_LEVEL=INFO
# 0 a 1: fracción de peticiones que responden 500 a propósito (demo 3).
# Se cambia con un commit, como todo lo demás.
ERROR_RATE=0
# Trazas por OTLP/HTTP a Jaeger (etapa 8). Cambiar a Tempo u otro backend
# OTLP solo cambiaría esta línea, no el código.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger.logging:4318
