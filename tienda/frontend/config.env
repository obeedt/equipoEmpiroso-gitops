# Configuración del frontend. Kustomize la convierte en el ConfigMap
# frontend-config-<hash>: si cambia un valor, el Deployment crea pods nuevos
# que la leen (ver kustomization.yaml).
# No usa la base de datos: todo lo pide por HTTP a los otros tres servicios,
# por sus Services internos.
OTEL_SERVICE_NAME=frontend
EVENTOS_URL=http://svc-eventos
RESERVACIONES_URL=http://svc-reservaciones
ORDENES_URL=http://svc-ordenes
TIMEOUT_SEGUNDOS=5
LOG_LEVEL=INFO
# 0 a 1: fracción de páginas que fallan a propósito (demo 3)
ERROR_RATE=0
# Aviso arriba de todas las páginas (vacío = sin aviso). Cambiarlo con un
# commit es una forma rápida de mostrar un cambio visible en la tienda.
BANNER=
# OTEL_EXPORTER_OTLP_ENDPOINT se agrega en la etapa de logs y trazas (Jaeger)
