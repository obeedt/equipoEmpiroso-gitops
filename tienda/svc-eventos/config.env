# Configuración de svc-eventos (lo que NO es secreto). Kustomize la convierte
# en el ConfigMap svc-eventos-config-<hash>: si cambia un valor, cambia el
# nombre y el Deployment crea pods nuevos que la leen (ver kustomization.yaml).
# La base, el usuario y la contraseña se toman de postgres-config y
# postgres-app (deployment.yaml), para no repetirlos.
OTEL_SERVICE_NAME=svc-eventos
DB_HOST=postgres
DB_PORT=5432
# Conexiones por réplica (2 réplicas = 10)
DB_POOL_MAX=5
LOG_LEVEL=INFO
# 0 a 1: fracción de peticiones que responden 500 a propósito (demo 3).
# Se cambia con un commit, como todo lo demás.
ERROR_RATE=0
# OTEL_EXPORTER_OTLP_ENDPOINT se agrega en la etapa de logs y trazas (Jaeger)
