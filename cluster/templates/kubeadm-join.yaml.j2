# Generado por Ansible — no editar a mano
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ k8s_api_name }}:6443"
    token: "{{ hostvars[groups['control_plane'][0]].join_token }}"
    caCertHashes:
      - "{{ hostvars[groups['control_plane'][0]].join_ca_hash }}"
nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: "unix:///run/containerd/containerd.sock"
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ ansible_host }}"
