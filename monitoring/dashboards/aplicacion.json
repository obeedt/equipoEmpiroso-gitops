    {
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(http_requests_total{namespace=\"tienda\", route!~\"/health.*|/metrics\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
